<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!-- From Keen's LargeProgrammableBlock in CubeBlocks_Automation.sbc, as a wall-mounted device. -->
    <Definition xsi:type="MyObjectBuilder_ProgrammableBlockDefinition">
      <Id>
        <TypeId>MyProgrammableBlock</TypeId>
        <SubtypeId>SprocketProgrammableBlock</SubtypeId>
      </Id>
      <Public>true</Public>
      <DisplayName>Sprocket Programmable Block</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\SprocketProgrammableBlock.dds</Icon>
      <Description>A programmable block by Sprocket Automation, mounted on a wall.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\large\SprocketProgrammableBlock.mwm</Model>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\SprocketProgrammableBlock_BS1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\large\SprocketProgrammableBlock_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\SprocketProgrammableBlock_BS3.mwm" />
      </BuildProgressModels>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Construction" Count="4" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="Display" Count="2" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="InteriorPlate" Count="6" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <ScreenAreas>
        <ScreenArea Name="CockpitScreen_02" DisplayName="DisplayName_Screen_Large" TextureResolution="512" ScreenWidth="16" ScreenHeight="10" />
        <ScreenArea Name="CockpitScreen_01" DisplayName="DisplayName_Screen_Keyboard" TextureResolution="256" ScreenWidth="5" ScreenHeight="2" />
      </ScreenAreas>
      <BlockPairName>SprocketProgrammableBlock</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <MountPoints>
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
      </MountPoints>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>
    <!-- The same device in a full cube's well, mounted on every side, as Keen's refill station comes in two. -->
    <Definition xsi:type="MyObjectBuilder_ProgrammableBlockDefinition">
      <Id>
        <TypeId>MyProgrammableBlock</TypeId>
        <SubtypeId>SprocketProgrammableBlockInset</SubtypeId>
      </Id>
      <Public>true</Public>
      <DisplayName>Sprocket Programmable Block Inset</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\SprocketProgrammableBlockInset.dds</Icon>
      <Description>A programmable block by Sprocket Automation, set into a full block.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\large\SprocketProgrammableBlockInset.mwm</Model>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\SprocketProgrammableBlockInset_BS1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\large\SprocketProgrammableBlockInset_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\SprocketProgrammableBlockInset_BS3.mwm" />
      </BuildProgressModels>
      <Components>
        <Component Subtype="SteelPlate" Count="24" />
        <Component Subtype="Construction" Count="4" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="Display" Count="2" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="InteriorPlate" Count="6" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <ScreenAreas>
        <ScreenArea Name="CockpitScreen_02" DisplayName="DisplayName_Screen_Large" TextureResolution="512" ScreenWidth="16" ScreenHeight="10" />
        <ScreenArea Name="CockpitScreen_01" DisplayName="DisplayName_Screen_Keyboard" TextureResolution="256" ScreenWidth="5" ScreenHeight="2" />
      </ScreenAreas>
      <BlockPairName>SprocketProgrammableBlockInset</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>100</PCU>
      <IsAirTight>true</IsAirTight>
    </Definition>
  </CubeBlocks>
</Definitions>
